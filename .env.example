# RoomieFit Environment Variables Template
# Copy this file to .env and fill in the values for local development.

# The connection string for your MongoDB database (e.g., mongodb://localhost:27017 or MongoDB Atlas connection string)
MONGODB_URI=your-mongodb-connection-string

# The name of the database to use
MONGODB_DB_NAME=roomiefit

# A secret string used by Better Auth to sign/verify tokens. Generate a secure one.
BETTER_AUTH_SECRET=your-better-auth-secret

# The base URL of the auth endpoints
BETTER_AUTH_URL=http://localhost:3000

# Client ID for Google OAuth authentication
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

# Client Secret for Google OAuth authentication
GOOGLE_CLIENT_SECRET=your-google-client-secret

# The public URL of the Next.js application
NEXT_PUBLIC_APP_URL=http://localhost:3000
